DATABASE_URL=postgresql+psycopg2://glassquote:glassquote@db:5432/glassquote
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=quotes@company.com
IMAP_PASSWORD=changeme
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true
IMAP_SUBJECT_FILTER=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=quotes@company.com
SMTP_PASSWORD=changeme
SMTP_USE_TLS=true
SMTP_FROM=quotes@company.com

OWNER_EMAIL=owner@company.com

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=changeme
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o-mini
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

# Optional: separate endpoint for vision calls only (falls back to LLM_BASE_URL/LLM_API_KEY if unset)
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=

APPROVAL_SECRET_KEY=changeme-signing-key
APPROVAL_TOKEN_MAX_AGE_SECONDS=604800
PUBLIC_BASE_URL=http://localhost:8000

# Worker app auth — generate a real random 32+ byte secret for deployment,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
JWT_SECRET_KEY=changeme-jwt-signing-key-replace-with-random-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=20160

RULES_PATH=app/engine/rules.yaml

# Geocoding for Anthony's job map (maps branch) — Nominatim/OpenStreetMap,
# free, no API key. GEOCODE_ENABLED=false returns only cached coordinates.
GEOCODE_USER_AGENT=glassquote-nsw-jobmap/1.0
GEOCODE_ENABLED=true
GEOCODE_MAX_LOOKUPS_PER_REQUEST=8
